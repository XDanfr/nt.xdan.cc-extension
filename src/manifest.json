{
  "manifest_version": 3,
  "name": "nt.xdan.cc New Tab",
  "short_name": "New Tab",
  "description": "A clean, customisable Material 3 Expressive new tab page from nt.xdan.cc.",
  "version": "1.0.0",
  "chrome_url_overrides": {
    "newtab": "newtab.html"
  },
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "newtab@nt.xdan.cc",
      "strict_min_version": "128.0",
      "data_collection_permissions": {
        "required": [
          "none"
        ]
      }
    }
  }
}
